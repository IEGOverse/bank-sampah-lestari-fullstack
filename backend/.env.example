# Contoh konfigurasi backend (salin menjadi .env, JANGAN commit .env)
PORT=3000
# URI PostgreSQL. Untuk dev lokal, jalankan: npm run db:up  (menulis URI ke file .db_uri)
DATABASE_URL=postgresql://postgres:@127.0.0.1:5432/bank_sampah_lestari
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=12h
# Origin frontend yang diizinkan (untuk production, isi domain frontend)
CORS_ORIGIN=*
